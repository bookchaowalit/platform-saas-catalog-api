# Runtime-only configuration. Replace placeholders; do not store credentials.
SAAS_CATALOG_API_HOST=0.0.0.0
SAAS_CATALOG_API_ENV=production
# PORT is assigned by the PaaS; optional SAAS_CATALOG_API_PORT overrides it.
SAAS_CATALOG_API_CATALOG_PATH=/app/data/free-saas-master-catalog-2026.json
SAAS_CATALOG_API_AUTH_ISSUER=https://solo-web.example
SAAS_CATALOG_API_AUTH_PUBLIC_KEY=REPLACE_WITH_PEM_RSA_PUBLIC_KEY
SAAS_CATALOG_API_AUTH_SUBJECTS=REPLACE_WITH_ALLOWED_OIDC_OWNER_SUBJECT
SAAS_CATALOG_API_CORS_ORIGINS=https://solo-web.example
